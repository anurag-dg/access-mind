# IAM Guardian — Environment Variables (Gemini edition)
# Copy this to .env and fill in your values

# Required: Gemini API key — free at aistudio.google.com
GEMINI_API_KEY=AIza...

# Option A: GCP Application Default Credentials (easiest if running locally)
#   Run once: gcloud auth application-default login

# Option B: GCP Service Account JSON (for Cloud Run / CI)
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
